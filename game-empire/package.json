{
  "name": "game-empire",
  "private": true,
  "version": "1.0.0",
  "description": "Game Empire - an advanced game development tycoon with a living simulated industry",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "sim": "vitest run src/engine/__tests__/longrun.test.ts --silent=false",
    "build:artifact": "node scripts/build-artifact.mjs dist-artifact/page"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
