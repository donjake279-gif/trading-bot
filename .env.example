# Copy to .env (never commit .env). Only needed if the bot must log in itself;
# with mt5.attach_to_running_terminal: true, the already-logged-in terminal is used.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# LIVE TRADING ONLY — must equal the REAL account login number, in addition to
# live.enabled: true and live.acknowledge_risk in settings.yaml. Leave empty for demo.
MT5BOT_LIVE_CONFIRM=
